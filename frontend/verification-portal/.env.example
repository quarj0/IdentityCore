# Browser-visible Django API origin. Do not use Docker service names here.
API_ORIGIN=http://localhost:8000

# Optional destination after the hosted verification finishes.
NEXT_PUBLIC_ONBOARDING_RETURN_URL=http://localhost:3001/onboarding

# Comma-separated origins that organizations may redirect subjects to after
# verification. Production redirects are denied unless their origin is listed.
NEXT_PUBLIC_ALLOWED_RETURN_ORIGINS=http://localhost:3001
