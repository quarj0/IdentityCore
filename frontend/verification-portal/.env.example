# Server-only Django API origin. Production requires an HTTPS origin.
API_ORIGIN=http://localhost:8000

# Release identifier included in readiness responses and operational telemetry.
DEPLOYMENT_VERSION=development

# Optional destination after the hosted verification finishes.
NEXT_PUBLIC_ONBOARDING_RETURN_URL=http://localhost:3001/onboarding

# Comma-separated origins that organizations may redirect subjects to after
# verification. Production redirects are denied unless their origin is listed.
NEXT_PUBLIC_ALLOWED_RETURN_ORIGINS=http://localhost:3001

# Server-only shared BFF/Django metadata key (random, at least 32 characters).
# Required by the production portal. Configure the same value on both servers.
VERIFICATION_METADATA_SECRET=

# Optional single-IP ingress header. Configure only when the trusted ingress
# overwrites it and direct portal access is blocked. Empty means unknown IP.
VERIFICATION_CLIENT_IP_HEADER=
