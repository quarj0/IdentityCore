{
  "name": "identitycore",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev:verify": "pnpm --filter verification-portal dev",
    "dev:web": "pnpm --filter identitycore-web dev",
    "dev:docs": "pnpm --filter developer-portal dev",
    "dev:admin": "pnpm --filter platform-admin dev",
    "test:e2e:verify:install": "pnpm --filter verification-portal test:e2e:install",
    "test:e2e:verify": "pnpm --filter verification-portal test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
