{
  "title": "IdentityCore operational SLIs",
  "uid": "identitycore-operations",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "identitycore-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(identitycore_responses_total[5m])) by (environment, outcome)",
          "legendFormat": "{{environment}} {{outcome}} {{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "identitycore-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(identitycore_operation_duration_seconds_bucket{component=\"api\"}[5m])) by (le, environment))",
          "legendFormat": "{{environment}} {{outcome}} {{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Processing completions",
      "datasource": {
        "type": "prometheus",
        "uid": "identitycore-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(identitycore_processing_completed_total[5m])) by (environment, outcome)",
          "legendFormat": "{{environment}} {{outcome}} {{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Processing p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "identitycore-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(identitycore_processing_duration_seconds_bucket[5m])) by (le, environment))",
          "legendFormat": "{{environment}} {{outcome}} {{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Provider attempts",
      "datasource": {
        "type": "prometheus",
        "uid": "identitycore-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(identitycore_operations_total{component=\"provider\"}[5m])) by (environment, outcome)",
          "legendFormat": "{{environment}} {{outcome}} {{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Webhook attempts",
      "datasource": {
        "type": "prometheus",
        "uid": "identitycore-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(identitycore_operations_total{component=\"webhook\"}[5m])) by (environment, outcome)",
          "legendFormat": "{{environment}} {{outcome}} {{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Storage operations",
      "datasource": {
        "type": "prometheus",
        "uid": "identitycore-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(identitycore_operations_total{component=\"storage\"}[5m])) by (environment, outcome)",
          "legendFormat": "{{environment}} {{outcome}} {{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Oldest durable work",
      "datasource": {
        "type": "prometheus",
        "uid": "identitycore-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(identitycore_backlog_oldest_seconds) by (queue, environment)",
          "legendFormat": "{{environment}} {{outcome}} {{queue}}",
          "refId": "A"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s"
}
